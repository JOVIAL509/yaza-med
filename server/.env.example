
PORT=4000
# Set NODE_ENV=production on the public host.
NODE_ENV=development
# Replace with your MongoDB Atlas connection string. The API reads MONGODB_URI.
MONGODB_URI=mongodb://127.0.0.1:27017/yaza_med
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
# For production, set CLIENT_ORIGINS=https://your-frontend.example.com
ADMIN_EMAIL=admin@yazamed.mw
ADMIN_PASSWORD=change-this-in-development
EMAIL_OTP_SECRET=replace-with-another-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="Yaza Med <your-sender@gmail.com>"
# Server-only Supabase Storage access. Never prefix these with VITE_ or put them in client/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-this-with-a-server-secret-key
SUPABASE_BUCKET=notes
# Server-only Gemini API access for AI handout quizzes. Never use a VITE_ prefix.
# Use the newly rotated key as GEMINI_API_KEY (or GOOGLE_API_KEY) on the API host.
GEMINI_API_KEY=replace-with-your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.8-flash
